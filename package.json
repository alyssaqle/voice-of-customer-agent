{
  "name": "voice-of-customer-agent",
  "version": "0.1.0",
  "description": "Agentic Voice-of-Customer tool: ingest multi-source feedback, theme + prioritize with an LLM pipeline, weight by source authority and revenue at risk, human-in-the-loop approval.",
  "type": "module",
  "scripts": {
    "generate": "tsx data/generate.ts",
