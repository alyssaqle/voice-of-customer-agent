  {
    "id": "case-12",
    "name": "ADVERSARIAL: widespread login bug vs a whale's cosmetic ask",
    "note": "Stress test. A sev-4 login failure hitting 50 users should beat a $1.6M account's sev-2 branding tweak. A pure revenue-weighted scorer may wrongly pick the whale — this case exists to catch that.",
    "accounts": [{ "account_id": "whale", "annual_revenue": 1600000, "tier": "enterprise" }],
    "themes": [
      { "theme_id": "login-bug", "title": "Login broken for many users (sev 4)", "severity": 4, "signals_spec": { "count": 50, "source": "app_review", "account": null } },
      { "theme_id": "whale-cosmetic", "title": "Whale account wants a branding tweak (sev 2)", "severity": 2, "signals_spec": { "count": 2, "source": "slack", "account": "whale" } }
    ],
    "expected_top": "login-bug"
  },
